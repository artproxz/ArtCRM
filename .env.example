# ArtCRM local development environment example.
# Copy this file to .env for local development only.
# Never commit a real .env file with production secrets, tokens, passwords,
# API keys, mail credentials, database credentials, or real model paths.
# Values below are demo/dev-safe placeholders and must be replaced locally.

# Application
APP_ENV=development
APP_NAME=ArtCRM
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# Frontend
FRONTEND_HOST=localhost
FRONTEND_PORT=3000
FRONTEND_API_BASE_URL=http://localhost:8000/api/v1

# Backend
BACKEND_HOST=localhost
BACKEND_PORT=8000
BACKEND_API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=artcrm_dev
POSTGRES_USER=artcrm_dev_user
POSTGRES_PASSWORD=demo_postgres_password_change_me
DATABASE_URL=postgresql://artcrm_dev_user:demo_postgres_password_change_me@localhost:5432/artcrm_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Mail
MAIL_HOST=mail.dev.local
MAIL_PORT=993
MAIL_USER=demo_mail_user@example.local
MAIL_PASSWORD=demo_mail_password_change_me
MAIL_USE_TLS=true

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MAIL_READER_MODEL=demo-mail-reader-model
OLLAMA_CATALOG_MATCHER_MODEL=demo-catalog-matcher-model

# Files
FILE_STORAGE_PATH=./storage/dev

# Security
SECRET_KEY=demo_secret_key_change_me
ACCESS_TOKEN_EXPIRE_MINUTES=60
